{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/agent_memory_policy.schema.json",
  "$comment": "AgentMemoryPolicy governs local memory without enabling a memory database.",
  "title": "AgentMemoryPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "correlation_id", "agent_memory_policy_id", "created_at", "memory_scope", "secret_storage_allowed", "credential_storage_allowed", "external_memory_allowed", "retention_days", "execution_allowed"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "agent_memory_policy_id": {"type": "string", "pattern": "^amp_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "memory_scope": {"type": "string", "enum": ["none", "local_research_only", "redacted_audit_only"]},
    "secret_storage_allowed": {"type": "boolean", "const": false},
    "credential_storage_allowed": {"type": "boolean", "const": false},
    "external_memory_allowed": {"type": "boolean", "const": false},
    "retention_days": {"type": "integer", "minimum": 0},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
