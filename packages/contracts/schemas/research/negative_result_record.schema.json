{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/negative_result_record.schema.json",
  "$comment": "NegativeResultRecord preserves adverse or failed research outcomes to prevent survivorship bias and overclaiming.",
  "title": "NegativeResultRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "negative_result_record_id",
    "subject",
    "recorded_at",
    "failure_category",
    "observed_issue",
    "severity",
    "lesson",
    "must_block_promotion",
    "production_approval_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "negative_result_record_id": {
      "type": "string",
      "pattern": "^nrr_[A-Za-z0-9_\\-]+$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "failure_category": {
      "type": "string",
      "enum": [
        "no_alpha",
        "overfitting",
        "data_leakage",
        "bad_calibration",
        "high_drawdown",
        "low_liquidity",
        "latency_sensitive",
        "operational_risk",
        "other"
      ]
    },
    "observed_issue": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "lesson": {
      "type": "string",
      "minLength": 1
    },
    "must_block_promotion": {
      "type": "boolean"
    },
    "production_approval_allowed": {
      "type": "boolean",
      "const": false
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    }
  }
}
