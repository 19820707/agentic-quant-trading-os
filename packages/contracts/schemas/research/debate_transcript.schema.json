{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/debate_transcript.schema.json",
  "$comment": "DebateTranscript captures advisory reasoning. It must not approve execution.",
  "title": "DebateTranscript",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "debate_transcript_id",
    "research_dossier_id",
    "debate_type",
    "created_at",
    "turns",
    "summary",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "debate_transcript_id": {
      "type": "string",
      "pattern": "^dt_[A-Za-z0-9_\\-]+$"
    },
    "research_dossier_id": {
      "type": "string",
      "pattern": "^rd_[A-Za-z0-9_\\-]+$"
    },
    "debate_type": {
      "type": "string",
      "enum": [
        "YES_NO",
        "RISK_ADVISORY",
        "MODEL_REVIEW",
        "GOVERNANCE_REVIEW"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "position",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "string",
            "enum": [
              "YES",
              "NO",
              "AGGRESSIVE",
              "CONSERVATIVE",
              "NEUTRAL",
              "MANAGER",
              "REVIEWER"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    }
  }
}
