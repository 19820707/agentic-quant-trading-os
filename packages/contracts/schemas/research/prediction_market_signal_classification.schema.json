{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/prediction_market_signal_classification.schema.json",
  "$comment": "PredictionMarketSignalClassification is non-executable research output. It must not create OrderIntent or approve execution.",
  "title": "PredictionMarketSignalClassification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "signal_classification_id",
    "subject",
    "classified_at",
    "signal",
    "edge",
    "confidence",
    "threshold_basis",
    "order_intent_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "signal_classification_id": {
      "type": "string",
      "pattern": "^pmsc_[A-Za-z0-9_\\-]+$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "classified_at": {
      "type": "string",
      "format": "date-time"
    },
    "signal": {
      "type": "string",
      "enum": [
        "STRONG_BUY",
        "BUY",
        "HOLD",
        "SELL",
        "STRONG_SELL"
      ]
    },
    "edge": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "threshold_basis": {
      "type": "string",
      "minLength": 1
    },
    "order_intent_allowed": {
      "type": "boolean",
      "const": false
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    }
  }
}
