{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/arbitrage_observation_audit.schema.json",
  "$comment": "ArbitrageObservationAudit reviews research observations without runtime authority.",
  "title": "ArbitrageObservationAudit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "arbitrage_observation_audit_id",
    "subject",
    "audited_at",
    "observation_ids",
    "finding",
    "audit_status",
    "order_reference_allowed",
    "wallet_reference_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "arbitrage_observation_audit_id": {
      "type": "string",
      "pattern": "^aoa_[A-Za-z0-9_\\-]+$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "audited_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "finding": {
      "type": "string",
      "minLength": 1
    },
    "audit_status": {
      "type": "string",
      "enum": [
        "reviewed",
        "blocked",
        "requires_followup"
      ]
    },
    "order_reference_allowed": {
      "type": "boolean",
      "const": false
    },
    "wallet_reference_allowed": {
      "type": "boolean",
      "const": false
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    }
  }
}
