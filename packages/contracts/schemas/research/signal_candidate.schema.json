{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/signal_candidate.schema.json",
  "$comment": "SignalCandidate is non-executable. It must not submit orders or bypass deterministic-risk-gateway.",
  "title": "SignalCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "signal_candidate_id",
    "probability_estimate_id",
    "created_at",
    "signal",
    "confidence",
    "rationale",
    "risk_flags",
    "order_intent_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "signal_candidate_id": {
      "type": "string",
      "pattern": "^sigcand_[A-Za-z0-9_\\-]+$"
    },
    "probability_estimate_id": {
      "type": "string",
      "pattern": "^pe_[A-Za-z0-9_\\-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "signal": {
      "type": "string",
      "enum": [
        "LONG",
        "SHORT",
        "FLAT",
        "YES",
        "NO",
        "PASS",
        "ABSTAIN"
      ]
    },
    "estimated_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "market_price": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "edge": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "order_intent_allowed": {
      "type": "boolean",
      "const": false
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    }
  }
}
