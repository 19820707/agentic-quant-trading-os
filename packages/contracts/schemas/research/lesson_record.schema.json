{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/lesson_record.schema.json",
  "$comment": "LessonRecord captures reviewed lessons derived from evidence.",
  "title": "LessonRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "correlation_id", "lesson_record_id", "created_at", "lesson_text", "evidence_ids", "confidence", "status", "human_review_required", "execution_allowed"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "lesson_record_id": {"type": "string", "pattern": "^lr_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "lesson_text": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["draft", "review_required", "approved_as_guidance", "superseded"]},
    "human_review_required": {"type": "boolean", "const": true},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
