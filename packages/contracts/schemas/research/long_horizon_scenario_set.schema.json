{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/long_horizon_scenario_set.schema.json",
  "$comment": "LongHorizonScenarioSet compares educational projections across horizons.",
  "title": "LongHorizonScenarioSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "correlation_id", "long_horizon_scenario_set_id", "created_at", "input_id", "horizons", "comparison_basis", "market_data_required", "recommendation_allowed", "execution_allowed"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "long_horizon_scenario_set_id": {"type": "string", "pattern": "^lhs_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "input_id": {"type": "string", "pattern": "^isi_[A-Za-z0-9_\\-]+$"},
    "horizons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["horizon_years", "projected_value", "estimated_monthly_income"],
        "properties": {
          "horizon_years": {"type": "integer", "minimum": 1, "maximum": 60},
          "projected_value": {"type": "number", "minimum": 0},
          "estimated_monthly_income": {"type": "number", "minimum": 0}
        }
      }
    },
    "comparison_basis": {"type": "string", "enum": ["static_assumption"]},
    "market_data_required": {"type": "boolean", "const": false},
    "recommendation_allowed": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
