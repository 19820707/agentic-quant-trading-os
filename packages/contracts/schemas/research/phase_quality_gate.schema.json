{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/phase_quality_gate.schema.json",
  "$comment": "PhaseQualityGate records Discover/Define/Develop/Review phase readiness.",
  "title": "PhaseQualityGate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "correlation_id", "phase_quality_gate_id", "created_at", "phase", "gate_state", "required_evidence", "missing_evidence", "human_review_required", "promotion_allowed", "execution_allowed"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "phase_quality_gate_id": {"type": "string", "pattern": "^pqg_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "phase": {"type": "string", "enum": ["discover", "define", "develop", "review"]},
    "gate_state": {"type": "string", "enum": ["blocked", "manual_review_required", "advisory_passed"]},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean", "const": true},
    "promotion_allowed": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
