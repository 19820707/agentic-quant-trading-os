{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/trend_flip_observation.schema.json",
  "$comment": "TrendFlipObservation records research events only.",
  "title": "TrendFlipObservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "trend_flip_observation_id",
    "subject",
    "flip_detected_at",
    "from_side",
    "to_side",
    "flip_reason",
    "switch_execution_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "trend_flip_observation_id": {"type": "string", "pattern": "^tfo_[A-Za-z0-9_\\-]+$"},
    "subject": {"type": "string", "minLength": 1},
    "flip_detected_at": {"type": "string", "format": "date-time"},
    "from_side": {"type": "string", "enum": ["YES", "NO", "UNKNOWN"]},
    "to_side": {"type": "string", "enum": ["YES", "NO", "UNKNOWN"]},
    "flip_reason": {"type": "string", "minLength": 1},
    "switch_execution_allowed": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
