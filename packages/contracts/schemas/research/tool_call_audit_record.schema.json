{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/tool_call_audit_record.schema.json",
  "$comment": "ToolCallAuditRecord captures proposed or blocked tool calls without sensitive payloads.",
  "title": "ToolCallAuditRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "tool_call_audit_record_id",
    "tool_name",
    "recorded_at",
    "call_status",
    "policy_decision",
    "redaction_applied",
    "sensitive_payload_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "tool_call_audit_record_id": {"type": "string", "pattern": "^tcar_[A-Za-z0-9_\\-]+$"},
    "tool_name": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "call_status": {"type": "string", "enum": ["proposed", "blocked", "simulated", "reviewed"]},
    "policy_decision": {"type": "string", "enum": ["allow_read_only", "block", "manual_review_required"]},
    "redaction_applied": {"type": "boolean", "const": true},
    "sensitive_payload_allowed": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
