{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/model_promotion_gate.schema.json",
  "$comment": "ModelPromotionGate records governance state for future model promotion. It does not approve production, risk or execution by itself.",
  "title": "ModelPromotionGate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "model_promotion_gate_id",
    "model_candidate_id",
    "created_at",
    "promotion_stage",
    "required_evidence",
    "blocking_issues",
    "promotion_allowed",
    "production_approval_allowed",
    "risk_approval_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "model_promotion_gate_id": {
      "type": "string",
      "pattern": "^mpg_[A-Za-z0-9_\\-]+$"
    },
    "model_candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "promotion_stage": {
      "type": "string",
      "enum": [
        "research",
        "backtest_review",
        "paper_review",
        "risk_review",
        "production_review"
      ]
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "point_in_time_dataset",
          "leakage_review",
          "calibration_report",
          "negative_result_review",
          "paper_evaluation",
          "risk_review",
          "human_governance_approval"
        ]
      }
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "promotion_allowed": {
      "type": "boolean",
      "const": false
    },
    "production_approval_allowed": {
      "type": "boolean",
      "const": false
    },
    "risk_approval_allowed": {
      "type": "boolean",
      "const": false
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    }
  }
}
