{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/adversarial_debate_record.schema.json",
  "$comment": "AdversarialDebateRecord captures structured disagreement without authority.",
  "title": "AdversarialDebateRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "correlation_id", "adversarial_debate_record_id", "created_at", "debate_subject", "debate_stage", "claims", "counterclaims", "unresolved_risks", "synthesis", "requires_human_review", "advisory_only", "execution_allowed"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "adversarial_debate_record_id": {"type": "string", "pattern": "^adr_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "debate_subject": {"type": "string", "minLength": 1},
    "debate_stage": {"type": "string", "enum": ["discover", "define", "develop", "review"]},
    "claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "counterclaims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unresolved_risks": {"type": "array", "items": {"type": "string"}},
    "synthesis": {"type": "string", "minLength": 1},
    "requires_human_review": {"type": "boolean", "const": true},
    "advisory_only": {"type": "boolean", "const": true},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
