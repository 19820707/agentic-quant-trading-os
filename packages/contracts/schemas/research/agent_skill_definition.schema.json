{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/agent_skill_definition.schema.json",
  "$comment": "AgentSkillDefinition catalogs a local skill without enabling runtime authority.",
  "title": "AgentSkillDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "agent_skill_definition_id",
    "skill_name",
    "created_at",
    "registry_layer",
    "skill_category",
    "enabled_by_default",
    "tool_use_allowed",
    "network_allowed",
    "credentials_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "agent_skill_definition_id": {"type": "string", "pattern": "^asd_[A-Za-z0-9_\\-]+$"},
    "skill_name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "registry_layer": {"type": "string", "enum": ["workspace", "project", "user", "bundled", "extra"]},
    "skill_category": {"type": "string", "enum": ["strategy_draft", "backtest_explain", "market_analysis", "risk_report", "indicator_guide", "exchange_setup", "custom_research"]},
    "enabled_by_default": {"type": "boolean", "const": false},
    "tool_use_allowed": {"type": "boolean", "const": false},
    "network_allowed": {"type": "boolean", "const": false},
    "credentials_allowed": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
