{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/implementation_plan_record.schema.json",
  "$comment": "ImplementationPlanRecord describes intended edits before implementation.",
  "title": "ImplementationPlanRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "correlation_id", "implementation_plan_record_id", "created_at", "plan_title", "expected_files", "planned_steps", "validation_commands", "rollback_plan", "approved_to_start", "execution_allowed"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "implementation_plan_record_id": {"type": "string", "pattern": "^ipr_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "plan_title": {"type": "string", "minLength": 1},
    "expected_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "planned_steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation_commands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback_plan": {"type": "string", "minLength": 1},
    "approved_to_start": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
