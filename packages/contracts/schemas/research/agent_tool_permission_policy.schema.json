{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/agent_tool_permission_policy.schema.json",
  "$comment": "AgentToolPermissionPolicy is fail-closed and does not grant tool authority.",
  "title": "AgentToolPermissionPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "agent_tool_permission_policy_id",
    "tool_name",
    "created_at",
    "risk_level",
    "shell_allowed",
    "file_write_allowed",
    "network_allowed",
    "credentials_allowed",
    "trading_allowed",
    "risk_approval_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "agent_tool_permission_policy_id": {"type": "string", "pattern": "^atpp_[A-Za-z0-9_\\-]+$"},
    "tool_name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "blocked"]},
    "shell_allowed": {"type": "boolean", "const": false},
    "file_write_allowed": {"type": "boolean", "const": false},
    "network_allowed": {"type": "boolean", "const": false},
    "credentials_allowed": {"type": "boolean", "const": false},
    "trading_allowed": {"type": "boolean", "const": false},
    "risk_approval_allowed": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
