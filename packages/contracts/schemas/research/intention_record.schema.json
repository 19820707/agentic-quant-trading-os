{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/intention_record.schema.json",
  "$comment": "IntentionRecord records open objectives without autonomous execution.",
  "title": "IntentionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "correlation_id", "intention_record_id", "created_at", "objective", "status", "owner", "blocked_by", "must_not_do", "autonomous_execution_allowed", "execution_allowed"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "intention_record_id": {"type": "string", "pattern": "^ir_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "objective": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["open", "blocked", "done", "abandoned"]},
    "owner": {"type": "string", "minLength": 1},
    "blocked_by": {"type": "array", "items": {"type": "string"}},
    "must_not_do": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "autonomous_execution_allowed": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
