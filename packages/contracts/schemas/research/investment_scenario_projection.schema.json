{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/investment_scenario_projection.schema.json",
  "$comment": "InvestmentScenarioProjection records deterministic educational projection output.",
  "title": "InvestmentScenarioProjection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "correlation_id", "investment_scenario_projection_id", "created_at", "input_id", "horizon_years", "total_contributed", "estimated_growth", "projected_value", "estimated_monthly_income", "calculation_method", "recommendation_allowed", "risk_approval_allowed", "execution_allowed"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "investment_scenario_projection_id": {"type": "string", "pattern": "^isp_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "input_id": {"type": "string", "pattern": "^isi_[A-Za-z0-9_\\-]+$"},
    "horizon_years": {"type": "integer", "minimum": 1, "maximum": 60},
    "total_contributed": {"type": "number", "minimum": 0},
    "estimated_growth": {"type": "number"},
    "projected_value": {"type": "number", "minimum": 0},
    "estimated_monthly_income": {"type": "number", "minimum": 0},
    "calculation_method": {"type": "string", "enum": ["compound_monthly_static_assumption"]},
    "recommendation_allowed": {"type": "boolean", "const": false},
    "risk_approval_allowed": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
