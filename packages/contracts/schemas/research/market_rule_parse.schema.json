{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/market_rule_parse.schema.json",
  "$comment": "MarketRuleParse captures research interpretation of a market rule. It is non-executable.",
  "title": "MarketRuleParse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "market_rule_parse_id",
    "subject",
    "parsed_at",
    "entity",
    "condition",
    "resolution_source",
    "ambiguity_score",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "market_rule_parse_id": {
      "type": "string",
      "pattern": "^mrp_[A-Za-z0-9_\\-]+$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "parsed_at": {
      "type": "string",
      "format": "date-time"
    },
    "entity": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "type": "string",
      "minLength": 1
    },
    "threshold": {
      "type": "string"
    },
    "resolution_source": {
      "type": "string",
      "minLength": 1
    },
    "ambiguity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    }
  }
}
