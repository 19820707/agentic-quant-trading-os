{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/research/agent_federation_policy.schema.json",
  "$comment": "AgentFederationPolicy blocks cross-machine and remote-agent behavior by default.",
  "title": "AgentFederationPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "correlation_id", "agent_federation_policy_id", "created_at", "cross_machine_allowed", "remote_agent_allowed", "external_identity_required", "credentials_allowed", "network_allowed", "execution_allowed"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "agent_federation_policy_id": {"type": "string", "pattern": "^afp_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "cross_machine_allowed": {"type": "boolean", "const": false},
    "remote_agent_allowed": {"type": "boolean", "const": false},
    "external_identity_required": {"type": "boolean", "const": true},
    "credentials_allowed": {"type": "boolean", "const": false},
    "network_allowed": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
