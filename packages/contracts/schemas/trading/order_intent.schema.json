{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-quant-trading-os.local/trading/order_intent.schema.json",
  "title": "OrderIntent",
  "description": "Non-executable trading intent created before deterministic risk review. This contract must never be sent directly to a broker or exchange.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "order_intent_id",
    "signal_id",
    "created_at",
    "instrument",
    "side",
    "intent_type",
    "quantity",
    "time_in_force",
    "execution_constraints",
    "risk_context",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "order_intent_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "signal_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "portfolio_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "asset_class"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "venue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "asset_class": {
          "type": "string",
          "enum": [
            "equity",
            "future",
            "option",
            "fx",
            "crypto",
            "fixed_income",
            "commodity",
            "fund",
            "other"
          ]
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "intent_type": {
      "type": "string",
      "enum": [
        "target_position",
        "rebalance",
        "open",
        "close",
        "reduce"
      ]
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "unit"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "unit": {
          "type": "string",
          "enum": [
            "shares",
            "contracts",
            "base_units",
            "notional"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "limit_price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "time_in_force": {
      "type": "string",
      "enum": [
        "day",
        "gtc",
        "ioc",
        "fok"
      ]
    },
    "execution_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_partial_fill",
        "max_slippage_bps"
      ],
      "properties": {
        "allow_partial_fill": {
          "type": "boolean"
        },
        "max_slippage_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "preferred_venue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "risk_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_risk_gateway",
        "is_executable"
      ],
      "properties": {
        "requires_risk_gateway": {
          "type": "boolean",
          "const": true
        },
        "is_executable": {
          "type": "boolean",
          "const": false
        },
        "model_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "maxItems": 20
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "signal-engine",
            "strategy",
            "agentic-review",
            "manual-research"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 1024
        }
      }
    }
  }
}
