{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/trading/execution_venue_capability.schema.json",
  "$comment": "ExecutionVenueCapability describes what a venue adapter may do. It is governance metadata only and does not enable broker/exchange connectivity.",
  "title": "ExecutionVenueCapability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "venue_capability_id",
    "venue_id",
    "venue_type",
    "capability_status",
    "read_only_market_data_allowed",
    "paper_trading_allowed",
    "order_submission_allowed",
    "order_cancellation_allowed",
    "position_mutation_allowed",
    "withdrawal_allowed",
    "transfer_allowed",
    "private_endpoint_allowed",
    "credentials_allowed",
    "risk_gateway_required",
    "approved_order_required",
    "direct_ai_to_venue_forbidden",
    "allowed_order_types",
    "allowed_data_modes",
    "prohibited_methods",
    "reviewed_at",
    "reviewed_by"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "venue_capability_id": {
      "type": "string",
      "pattern": "^venue_cap_[A-Za-z0-9_\\-]+$"
    },
    "venue_id": {
      "type": "string",
      "minLength": 1
    },
    "venue_type": {
      "type": "string",
      "enum": [
        "PAPER",
        "SIMULATED",
        "BROKER",
        "EXCHANGE"
      ]
    },
    "capability_status": {
      "type": "string",
      "enum": [
        "SCAFFOLD_ONLY",
        "READ_ONLY_REVIEW",
        "PAPER_ONLY",
        "BLOCKED"
      ]
    },
    "read_only_market_data_allowed": {
      "type": "boolean"
    },
    "paper_trading_allowed": {
      "type": "boolean"
    },
    "order_submission_allowed": {
      "type": "boolean",
      "const": false
    },
    "order_cancellation_allowed": {
      "type": "boolean",
      "const": false
    },
    "position_mutation_allowed": {
      "type": "boolean",
      "const": false
    },
    "withdrawal_allowed": {
      "type": "boolean",
      "const": false
    },
    "transfer_allowed": {
      "type": "boolean",
      "const": false
    },
    "private_endpoint_allowed": {
      "type": "boolean",
      "const": false
    },
    "credentials_allowed": {
      "type": "boolean",
      "const": false
    },
    "risk_gateway_required": {
      "type": "boolean",
      "const": true
    },
    "approved_order_required": {
      "type": "boolean",
      "const": true
    },
    "direct_ai_to_venue_forbidden": {
      "type": "boolean",
      "const": true
    },
    "allowed_order_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "MARKET",
          "LIMIT",
          "STOP",
          "STOP_LIMIT",
          "TAKE_PROFIT",
          "TAKE_PROFIT_LIMIT"
        ]
      }
    },
    "allowed_data_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "STATIC_FIXTURE",
          "FAKE_IN_MEMORY",
          "READ_ONLY_PUBLIC"
        ]
      }
    },
    "prohibited_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  }
}
