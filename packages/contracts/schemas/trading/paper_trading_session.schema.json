{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/trading/paper_trading_session.schema.json",
  "$comment": "PaperTradingSession defines controlled paper-mode assumptions. It does not approve broker access or production execution.",
  "title": "PaperTradingSession",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "paper_session_id",
    "strategy_id",
    "session_status",
    "initial_cash",
    "base_currency",
    "allowed_venues",
    "allowed_symbols",
    "fee_model",
    "slippage_model",
    "latency_model",
    "risk_gateway_required",
    "approved_order_required",
    "real_broker_allowed",
    "credentials_allowed",
    "production_allowed",
    "started_at",
    "created_by"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_session_id": {
      "type": "string",
      "pattern": "^paper_session_[A-Za-z0-9_\\-]+$"
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "session_status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "READY_FOR_FAKE_RUN",
        "RUNNING_FAKE",
        "COMPLETED",
        "BLOCKED"
      ]
    },
    "initial_cash": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "base_currency": {
      "type": "string",
      "minLength": 1
    },
    "allowed_venues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "allowed_symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "fee_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_type",
        "bps"
      ],
      "properties": {
        "model_type": {
          "type": "string",
          "enum": [
            "FIXED_BPS",
            "ZERO_FEE"
          ]
        },
        "bps": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "slippage_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_type",
        "bps"
      ],
      "properties": {
        "model_type": {
          "type": "string",
          "enum": [
            "FIXED_BPS",
            "ZERO_SLIPPAGE"
          ]
        },
        "bps": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "latency_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_type",
        "milliseconds"
      ],
      "properties": {
        "model_type": {
          "type": "string",
          "enum": [
            "FIXED_LATENCY",
            "ZERO_LATENCY"
          ]
        },
        "milliseconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "risk_gateway_required": {
      "type": "boolean",
      "const": true
    },
    "approved_order_required": {
      "type": "boolean",
      "const": true
    },
    "real_broker_allowed": {
      "type": "boolean",
      "const": false
    },
    "credentials_allowed": {
      "type": "boolean",
      "const": false
    },
    "production_allowed": {
      "type": "boolean",
      "const": false
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  }
}
