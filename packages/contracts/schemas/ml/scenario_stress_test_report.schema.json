{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/ml/scenario_stress_test_report.schema.json",
  "$comment": "ScenarioStressTestReport records safe policy behavior across synthetic stress regimes without market access or execution.",
  "title": "ScenarioStressTestReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "scenario_stress_test_report_id",
    "created_at",
    "policy_id",
    "scenario_id",
    "market_regime",
    "liquidity_condition",
    "volatility_condition",
    "adversarial_condition",
    "policy_response",
    "failure_mode",
    "constraints_checked",
    "stress_passed",
    "blocked_on_failure",
    "manual_review_required",
    "network_allowed",
    "credentials_allowed",
    "policy_execution_allowed",
    "risk_approval_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "scenario_stress_test_report_id": {"type": "string", "pattern": "^sstr_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "policy_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "market_regime": {
      "type": "string",
      "enum": ["bull", "bear", "sideways", "crash", "liquidity_shock", "volatility_spike"]
    },
    "liquidity_condition": {"type": "string", "enum": ["normal", "thin", "fragmented", "stressed"]},
    "volatility_condition": {"type": "string", "enum": ["low", "normal", "high", "extreme"]},
    "adversarial_condition": {"type": "string", "enum": ["none", "spread_widening", "stale_data", "gap_move", "model_disagreement"]},
    "policy_response": {"type": "string", "enum": ["hold_research_only", "freeze_policy", "require_manual_review", "revert_to_baseline"]},
    "failure_mode": {"type": "string", "enum": ["none", "constraint_breach", "uncertainty_too_high", "stale_data", "unsafe_action"]},
    "constraints_checked": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "stress_passed": {"type": "boolean"},
    "blocked_on_failure": {"type": "boolean", "const": true},
    "manual_review_required": {"type": "boolean", "const": true},
    "network_allowed": {"type": "boolean", "const": false},
    "credentials_allowed": {"type": "boolean", "const": false},
    "policy_execution_allowed": {"type": "boolean", "const": false},
    "risk_approval_allowed": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
