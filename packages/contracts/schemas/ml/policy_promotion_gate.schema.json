{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/ml/policy_promotion_gate.schema.json",
  "$comment": "PolicyPromotionGate blocks promotion of learned policies unless explicit evidence and approvals exist.",
  "title": "PolicyPromotionGate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "policy_promotion_gate_id",
    "created_at",
    "policy_id",
    "source_evaluation_report_id",
    "promotion_stage",
    "approval_status",
    "required_evidence",
    "required_approvals",
    "safety_layer_required",
    "deterministic_gateway_required",
    "human_governance_required",
    "approved_for_paper",
    "approved_for_market_execution",
    "pyproject_change_allowed",
    "dependency_allowed",
    "network_allowed",
    "credentials_allowed",
    "runtime_training_allowed",
    "policy_execution_allowed",
    "risk_approval_allowed",
    "execution_allowed",
    "production_enabled"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "policy_promotion_gate_id": {"type": "string", "pattern": "^ppg_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "policy_id": {"type": "string", "minLength": 1},
    "source_evaluation_report_id": {"type": "string", "pattern": "^sper_[A-Za-z0-9_\\-]+$"},
    "promotion_stage": {"type": "string", "enum": ["research_only", "paper_only", "blocked"]},
    "approval_status": {"type": "string", "enum": ["REJECTED", "PENDING", "HUMAN_REVIEW_REQUIRED"]},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["security", "risk_architecture", "platform_reliability", "model_risk", "maintainer"]
      }
    },
    "safety_layer_required": {"type": "boolean", "const": true},
    "deterministic_gateway_required": {"type": "boolean", "const": true},
    "human_governance_required": {"type": "boolean", "const": true},
    "approved_for_paper": {"type": "boolean", "const": false},
    "approved_for_market_execution": {"type": "boolean", "const": false},
    "pyproject_change_allowed": {"type": "boolean", "const": false},
    "dependency_allowed": {"type": "boolean", "const": false},
    "network_allowed": {"type": "boolean", "const": false},
    "credentials_allowed": {"type": "boolean", "const": false},
    "runtime_training_allowed": {"type": "boolean", "const": false},
    "policy_execution_allowed": {"type": "boolean", "const": false},
    "risk_approval_allowed": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false},
    "production_enabled": {"type": "boolean", "const": false}
  }
}
