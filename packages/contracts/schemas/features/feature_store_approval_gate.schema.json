{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/features/feature_store_approval_gate.schema.json",
  "$comment": "FeatureStoreApprovalGate is a fail-closed control-plane contract. It does not approve real feature store runtime, materialization, training, backtesting, risk or execution.",
  "title": "FeatureStoreApprovalGate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "feature_store_approval_gate_id",
    "created_at",
    "gate_scope",
    "feature_view_contract_id",
    "dataset_lineage_record_id",
    "leakage_review_report_id",
    "required_evidence",
    "required_approvals",
    "allowed_next_stage",
    "approved_for_fake_offline_materialization",
    "real_feature_store_allowed",
    "online_serving_allowed",
    "materialization_allowed",
    "model_training_approval_allowed",
    "backtest_approval_allowed",
    "network_allowed",
    "credentials_allowed",
    "production_approval_allowed",
    "risk_approval_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_store_approval_gate_id": {
      "type": "string",
      "pattern": "^fsag_[A-Za-z0-9_\\-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "gate_scope": {
      "type": "string",
      "enum": [
        "metadata_only",
        "fake_offline_materialization_candidate",
        "blocked"
      ]
    },
    "feature_view_contract_id": {
      "type": "string",
      "pattern": "^fvc_[A-Za-z0-9_\\-]+$"
    },
    "dataset_lineage_record_id": {
      "type": "string",
      "pattern": "^dlr_[A-Za-z0-9_\\-]+$"
    },
    "leakage_review_report_id": {
      "type": "string",
      "pattern": "^lrr_[A-Za-z0-9_\\-]+$"
    },
    "required_evidence": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "dataset_lineage_record",
          "leakage_review_report",
          "feature_view_contract",
          "point_in_time_join_plan",
          "rollback_plan",
          "human_review_record"
        ]
      }
    },
    "required_approvals": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "data_engineering",
          "risk_architecture",
          "platform_reliability",
          "model_risk",
          "maintainer"
        ]
      }
    },
    "allowed_next_stage": {
      "type": "string",
      "enum": [
        "none",
        "fake_offline_materialization_review"
      ]
    },
    "approved_for_fake_offline_materialization": {
      "type": "boolean",
      "const": false
    },
    "real_feature_store_allowed": {
      "type": "boolean",
      "const": false
    },
    "online_serving_allowed": {
      "type": "boolean",
      "const": false
    },
    "materialization_allowed": {
      "type": "boolean",
      "const": false
    },
    "model_training_approval_allowed": {
      "type": "boolean",
      "const": false
    },
    "backtest_approval_allowed": {
      "type": "boolean",
      "const": false
    },
    "network_allowed": {
      "type": "boolean",
      "const": false
    },
    "credentials_allowed": {
      "type": "boolean",
      "const": false
    },
    "production_approval_allowed": {
      "type": "boolean",
      "const": false
    },
    "risk_approval_allowed": {
      "type": "boolean",
      "const": false
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    }
  }
}
