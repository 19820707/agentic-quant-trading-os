{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/features/point_in_time_join_plan.schema.json",
  "$comment": "PointInTimeJoinPlan documents safe feature joins. It does not execute joins or approve model training.",
  "title": "PointInTimeJoinPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "point_in_time_join_plan_id",
    "join_plan_name",
    "created_at",
    "left_dataset_id",
    "right_feature_view_contract_id",
    "entity_keys",
    "join_timestamp_field",
    "feature_available_timestamp_field",
    "max_lookback_seconds",
    "future_data_join_allowed",
    "leakage_review_required",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "point_in_time_join_plan_id": {
      "type": "string",
      "pattern": "^pitjp_[A-Za-z0-9_\\-]+$"
    },
    "join_plan_name": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "left_dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "right_feature_view_contract_id": {
      "type": "string",
      "pattern": "^fvc_[A-Za-z0-9_\\-]+$"
    },
    "entity_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "join_timestamp_field": {
      "type": "string",
      "const": "event_timestamp"
    },
    "feature_available_timestamp_field": {
      "type": "string",
      "const": "available_timestamp"
    },
    "max_lookback_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "future_data_join_allowed": {
      "type": "boolean",
      "const": false
    },
    "leakage_review_required": {
      "type": "boolean",
      "const": true
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    }
  }
}
