{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/features/dataset_lineage_record.schema.json",
  "$comment": "DatasetLineageRecord preserves point-in-time lineage for datasets. It does not approve model training, risk or execution.",
  "title": "DatasetLineageRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "dataset_lineage_record_id",
    "dataset_id",
    "dataset_version",
    "created_at",
    "event_timestamp_field",
    "created_timestamp_field",
    "available_timestamp_field",
    "label_timestamp_field",
    "label_horizon_seconds",
    "dataset_window",
    "feature_availability_lag_seconds",
    "source_snapshots",
    "transformation_ids",
    "split_policy",
    "point_in_time_validated",
    "leakage_review_required",
    "model_training_approval_allowed",
    "backtest_approval_allowed",
    "network_allowed",
    "credentials_allowed",
    "production_approval_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_lineage_record_id": {
      "type": "string",
      "pattern": "^dlr_[A-Za-z0-9_\\-]+$"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_timestamp_field": {
      "type": "string",
      "const": "event_timestamp"
    },
    "created_timestamp_field": {
      "type": "string",
      "const": "created_timestamp"
    },
    "available_timestamp_field": {
      "type": "string",
      "const": "available_timestamp"
    },
    "label_timestamp_field": {
      "type": "string",
      "const": "label_timestamp"
    },
    "label_horizon_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "dataset_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_timestamp",
        "end_timestamp"
      ],
      "properties": {
        "start_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "end_timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "feature_availability_lag_seconds": {
      "type": "number",
      "minimum": 0
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "snapshot_id",
          "as_of_timestamp"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "fixture",
              "market_data",
              "news",
              "macro",
              "feature_store",
              "other"
            ]
          },
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "as_of_timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "transformation_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split_type",
        "temporal_order_preserved",
        "shuffle_allowed"
      ],
      "properties": {
        "split_type": {
          "type": "string",
          "enum": [
            "temporal_holdout",
            "walk_forward",
            "purged_kfold"
          ]
        },
        "temporal_order_preserved": {
          "type": "boolean",
          "const": true
        },
        "shuffle_allowed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "point_in_time_validated": {
      "type": "boolean",
      "const": true
    },
    "leakage_review_required": {
      "type": "boolean",
      "const": true
    },
    "model_training_approval_allowed": {
      "type": "boolean",
      "const": false
    },
    "backtest_approval_allowed": {
      "type": "boolean",
      "const": false
    },
    "network_allowed": {
      "type": "boolean",
      "const": false
    },
    "credentials_allowed": {
      "type": "boolean",
      "const": false
    },
    "production_approval_allowed": {
      "type": "boolean",
      "const": false
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    }
  }
}
