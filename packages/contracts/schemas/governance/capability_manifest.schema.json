{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/governance/capability_manifest.schema.json",
  "$comment": "CapabilityManifest maps repository capabilities to maturity state, contracts, tests, gates and forbidden states.",
  "title": "CapabilityManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "capability_manifest_id",
    "created_at",
    "repository_phase",
    "capabilities",
    "forbidden_global_states",
    "runtime_defaults"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_manifest_id": {
      "type": "string",
      "pattern": "^capman_[A-Za-z0-9_\\-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository_phase": {
      "type": "string",
      "enum": [
        "SCAFFOLD_ONLY",
        "CONTRACT_DEFINED",
        "FAKE_RUNTIME_ONLY",
        "PRODUCTION_BLOCKED"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "current_status",
          "allowed_capability",
          "forbidden_capability",
          "required_contracts",
          "required_tests",
          "required_approval_gate",
          "promotion_target",
          "owner_boundary"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "current_status": {
            "$ref": "#/$defs/maturity_state"
          },
          "allowed_capability": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden_capability": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_contracts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_approval_gate": {
            "type": "string",
            "minLength": 1
          },
          "promotion_target": {
            "$ref": "#/$defs/maturity_state"
          },
          "owner_boundary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "forbidden_global_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "LIVE_TRADING_ENABLED",
          "BROKER_PRIVATE_ENDPOINTS",
          "ORDER_SUBMISSION",
          "ORDER_CANCELLATION",
          "POSITION_MUTATION",
          "UNREVIEWED_AGENT_RUNTIME",
          "UNGATED_MEMORY_RUNTIME",
          "UNGATED_NETWORK_ACCESS",
          "UNGATED_CREDENTIAL_ACCESS",
          "BYPASS_DETERMINISTIC_RISK_GATEWAY"
        ]
      }
    },
    "runtime_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_enabled",
        "production_enabled",
        "network_access_allowed",
        "credentials_allowed",
        "private_endpoints_allowed",
        "trading_methods_allowed",
        "risk_approval_allowed",
        "execution_approval_allowed"
      ],
      "properties": {
        "runtime_enabled": {
          "type": "boolean",
          "const": false
        },
        "production_enabled": {
          "type": "boolean",
          "const": false
        },
        "network_access_allowed": {
          "type": "boolean",
          "const": false
        },
        "credentials_allowed": {
          "type": "boolean",
          "const": false
        },
        "private_endpoints_allowed": {
          "type": "boolean",
          "const": false
        },
        "trading_methods_allowed": {
          "type": "boolean",
          "const": false
        },
        "risk_approval_allowed": {
          "type": "boolean",
          "const": false
        },
        "execution_approval_allowed": {
          "type": "boolean",
          "const": false
        }
      }
    }
  },
  "$defs": {
    "maturity_state": {
      "type": "string",
      "enum": [
        "SCAFFOLD_ONLY",
        "CONTRACT_DEFINED",
        "FAKE_RUNTIME_ONLY",
        "READ_ONLY_ADAPTER_ONLY",
        "PAPER_ONLY",
        "GATED_LIVE_READ_ONLY",
        "GATED_LIVE_EXECUTION",
        "PRODUCTION_BLOCKED"
      ]
    }
  }
}
