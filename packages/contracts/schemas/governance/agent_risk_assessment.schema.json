{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/governance/agent_risk_assessment.schema.json",
  "$comment": "AgentRiskAssessment records deterministic policy classification. It cannot approve execution, credentials, network access, direct main writes or auto-merge.",
  "title": "AgentRiskAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "agent_risk_assessment_id",
    "agent_task_spec_id",
    "agent_patch_plan_id",
    "created_at",
    "risk_level",
    "policy_decision",
    "policy_findings",
    "sandbox_required",
    "test_evidence_required",
    "human_review_required",
    "direct_main_write_allowed",
    "auto_merge_allowed",
    "network_allowed",
    "credentials_allowed",
    "trading_changes_allowed",
    "risk_approval_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_risk_assessment_id": {
      "type": "string",
      "pattern": "^ara_[A-Za-z0-9_\\-]+$"
    },
    "agent_task_spec_id": {
      "type": "string",
      "pattern": "^ats_[A-Za-z0-9_\\-]+$"
    },
    "agent_patch_plan_id": {
      "type": "string",
      "pattern": "^app_[A-Za-z0-9_\\-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "policy_decision": {
      "type": "string",
      "enum": [
        "allow_pr_only",
        "require_human_review",
        "block"
      ]
    },
    "policy_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "severity",
          "summary"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^arf_[A-Za-z0-9_\\-]+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "blocking"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sandbox_required": {
      "type": "boolean",
      "const": true
    },
    "test_evidence_required": {
      "type": "boolean",
      "const": true
    },
    "human_review_required": {
      "type": "boolean",
      "const": true
    },
    "direct_main_write_allowed": {
      "type": "boolean",
      "const": false
    },
    "auto_merge_allowed": {
      "type": "boolean",
      "const": false
    },
    "network_allowed": {
      "type": "boolean",
      "const": false
    },
    "credentials_allowed": {
      "type": "boolean",
      "const": false
    },
    "trading_changes_allowed": {
      "type": "boolean",
      "const": false
    },
    "risk_approval_allowed": {
      "type": "boolean",
      "const": false
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    }
  }
}
