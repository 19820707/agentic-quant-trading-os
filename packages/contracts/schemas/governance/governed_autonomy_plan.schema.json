{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/governance/governed_autonomy_plan.schema.json",
  "$comment": "A governed autonomy plan may prepare safe branch work only. It cannot grant main writes, auto-merge, network access, credentials, risk approval or execution.",
  "title": "GovernedAutonomyPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "plan_id",
    "sprint_id",
    "created_at",
    "work_orders",
    "required_evidence",
    "ready_count",
    "human_review_count",
    "blocked_count",
    "deferred_count",
    "direct_main_write_allowed",
    "auto_merge_allowed",
    "network_allowed",
    "credentials_allowed",
    "risk_approval_allowed",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "pattern": "^gap_[A-Za-z0-9_\\-]+$"},
    "sprint_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "work_orders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mission_id",
          "title",
          "state",
          "risk_level",
          "policy_decision",
          "target_files",
          "test_commands",
          "required_evidence",
          "permitted_actions",
          "rationale",
          "human_review_required",
          "branch_only",
          "direct_main_write_allowed",
          "auto_merge_allowed",
          "network_allowed",
          "credentials_allowed",
          "risk_approval_allowed",
          "execution_allowed"
        ],
        "properties": {
          "mission_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "state": {
            "type": "string",
            "enum": ["ready_for_pr_preparation", "human_review_required", "blocked", "deferred"]
          },
          "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "policy_decision": {"type": "string", "enum": ["allow_pr_only", "require_human_review", "block"]},
          "target_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "test_commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "required_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "permitted_actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["plan", "modify_files_in_branch", "run_local_tests", "prepare_draft_pr", "request_human_review", "record_evidence"]
            }
          },
          "rationale": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "human_review_required": {"type": "boolean"},
          "branch_only": {"type": "boolean", "const": true},
          "direct_main_write_allowed": {"type": "boolean", "const": false},
          "auto_merge_allowed": {"type": "boolean", "const": false},
          "network_allowed": {"type": "boolean", "const": false},
          "credentials_allowed": {"type": "boolean", "const": false},
          "risk_approval_allowed": {"type": "boolean", "const": false},
          "execution_allowed": {"type": "boolean", "const": false}
        }
      }
    },
    "required_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "ready_count": {"type": "integer", "minimum": 0},
    "human_review_count": {"type": "integer", "minimum": 0},
    "blocked_count": {"type": "integer", "minimum": 0},
    "deferred_count": {"type": "integer", "minimum": 0},
    "direct_main_write_allowed": {"type": "boolean", "const": false},
    "auto_merge_allowed": {"type": "boolean", "const": false},
    "network_allowed": {"type": "boolean", "const": false},
    "credentials_allowed": {"type": "boolean", "const": false},
    "risk_approval_allowed": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false}
  }
}
