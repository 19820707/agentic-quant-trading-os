{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/governance/maintenance_finding_record.schema.json",
  "title": "MaintenanceFindingRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "maintenance_finding_record_id",
    "created_at",
    "repository",
    "source",
    "finding_type",
    "severity",
    "risk_class",
    "evidence",
    "patch_allowed",
    "human_review_required",
    "repository_write_allowed",
    "auto_merge_allowed",
    "credentials_allowed"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "maintenance_finding_record_id": {"type": "string", "pattern": "^mfr_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "minLength": 1},
    "source": {"type": "string", "enum": ["ci", "codeql", "secret_artifact_audit", "contract_test", "manual_review", "external_reference"]},
    "finding_type": {"type": "string", "enum": ["ci_failure", "contract_failure", "secret_risk", "artifact_risk", "security_finding", "dependency_risk", "policy_violation"]},
    "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "risk_class": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "patch_allowed": {"type": "boolean"},
    "human_review_required": {"type": "boolean", "const": true},
    "repository_write_allowed": {"type": "boolean", "const": false},
    "auto_merge_allowed": {"type": "boolean", "const": false},
    "credentials_allowed": {"type": "boolean", "const": false}
  }
}
