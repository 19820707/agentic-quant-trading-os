{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/governance/maintenance_evidence_record.schema.json",
  "title": "MaintenanceEvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "maintenance_evidence_record_id",
    "created_at",
    "repository",
    "finding_id",
    "patch_plan_id",
    "policy_decision_id",
    "evidence_items",
    "tests_executed",
    "audit_required",
    "rollback_required",
    "contains_credentials",
    "repository_write_performed",
    "auto_merge_performed"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "maintenance_evidence_record_id": {"type": "string", "pattern": "^mer_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "minLength": 1},
    "finding_id": {"type": "string", "pattern": "^mfr_[A-Za-z0-9_\\-]+$"},
    "patch_plan_id": {"type": "string", "pattern": "^ppr_[A-Za-z0-9_\\-]+$"},
    "policy_decision_id": {"type": "string", "pattern": "^acpd_[A-Za-z0-9_\\-]+$"},
    "evidence_items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "tests_executed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "audit_required": {"type": "boolean", "const": true},
    "rollback_required": {"type": "boolean", "const": true},
    "contains_credentials": {"type": "boolean", "const": false},
    "repository_write_performed": {"type": "boolean", "const": false},
    "auto_merge_performed": {"type": "boolean", "const": false}
  }
}
