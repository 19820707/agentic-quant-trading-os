{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/governance/agent_pr_review_evidence.schema.json",
  "$comment": "AgentPRReviewEvidence records pull-request review evidence for agent-authored changes. It grants no auto-merge, direct main write, credential, network, risk or execution authority.",
  "title": "AgentPRReviewEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "agent_pr_review_evidence_id",
    "agent_patch_plan_id",
    "agent_risk_assessment_id",
    "test_evidence_report_id",
    "rollback_plan_id",
    "created_at",
    "review_status",
    "risk_level",
    "reviewed_files",
    "unresolved_blocking_findings",
    "required_reviewers",
    "security_boundary_verified",
    "human_review_required",
    "ready_for_human_approval",
    "auto_merge_allowed",
    "direct_main_write_allowed",
    "network_allowed",
    "credentials_allowed",
    "trading_changes_allowed",
    "risk_approval_allowed",
    "execution_allowed",
    "production_allowed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_pr_review_evidence_id": {
      "type": "string",
      "pattern": "^apre_[A-Za-z0-9_\\-]+$"
    },
    "agent_patch_plan_id": {
      "type": "string",
      "pattern": "^app_[A-Za-z0-9_\\-]+$"
    },
    "agent_risk_assessment_id": {
      "type": "string",
      "pattern": "^ara_[A-Za-z0-9_\\-]+$"
    },
    "test_evidence_report_id": {
      "type": "string",
      "pattern": "^ter_[A-Za-z0-9_\\-]+$"
    },
    "rollback_plan_id": {
      "type": "string",
      "pattern": "^rbp_[A-Za-z0-9_\\-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "ready_for_human_review",
        "changes_requested",
        "blocked"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "reviewed_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_blocking_findings": {
      "type": "integer",
      "minimum": 0
    },
    "required_reviewers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "maintainer",
          "security_reviewer",
          "platform_reliability",
          "risk_architecture"
        ]
      }
    },
    "security_boundary_verified": {
      "type": "boolean"
    },
    "human_review_required": {
      "type": "boolean",
      "const": true
    },
    "ready_for_human_approval": {
      "type": "boolean"
    },
    "auto_merge_allowed": {
      "type": "boolean",
      "const": false
    },
    "direct_main_write_allowed": {
      "type": "boolean",
      "const": false
    },
    "network_allowed": {
      "type": "boolean",
      "const": false
    },
    "credentials_allowed": {
      "type": "boolean",
      "const": false
    },
    "trading_changes_allowed": {
      "type": "boolean",
      "const": false
    },
    "risk_approval_allowed": {
      "type": "boolean",
      "const": false
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    },
    "production_allowed": {
      "type": "boolean",
      "const": false
    }
  }
}
