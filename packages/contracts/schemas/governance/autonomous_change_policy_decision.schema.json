{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/governance/autonomous_change_policy_decision.schema.json",
  "title": "AutonomousChangePolicyDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "autonomous_change_policy_decision_id",
    "created_at",
    "finding_id",
    "patch_plan_id",
    "risk_class",
    "decision",
    "allowed_next_action",
    "human_review_required",
    "repository_write_allowed",
    "branch_creation_allowed",
    "pull_request_allowed",
    "auto_merge_allowed",
    "credentials_allowed",
    "production_enabled"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "autonomous_change_policy_decision_id": {"type": "string", "pattern": "^acpd_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "finding_id": {"type": "string", "pattern": "^mfr_[A-Za-z0-9_\\-]+$"},
    "patch_plan_id": {"type": "string", "pattern": "^ppr_[A-Za-z0-9_\\-]+$"},
    "risk_class": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "decision": {"type": "string", "enum": ["BLOCK", "PLAN_ONLY", "REQUIRE_HUMAN_REVIEW"]},
    "allowed_next_action": {"type": "string", "enum": ["none", "draft_patch_plan", "manual_review"]},
    "human_review_required": {"type": "boolean", "const": true},
    "repository_write_allowed": {"type": "boolean", "const": false},
    "branch_creation_allowed": {"type": "boolean", "const": false},
    "pull_request_allowed": {"type": "boolean", "const": false},
    "auto_merge_allowed": {"type": "boolean", "const": false},
    "credentials_allowed": {"type": "boolean", "const": false},
    "production_enabled": {"type": "boolean", "const": false}
  }
}
