{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/governance/patch_plan_record.schema.json",
  "title": "PatchPlanRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "patch_plan_record_id",
    "created_at",
    "finding_id",
    "risk_class",
    "planned_files",
    "planned_tests",
    "rollback_plan",
    "sandbox_required",
    "branch_creation_allowed",
    "commit_allowed",
    "pull_request_allowed",
    "auto_merge_allowed",
    "touches_trading_or_execution",
    "credentials_allowed"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "patch_plan_record_id": {"type": "string", "pattern": "^ppr_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "finding_id": {"type": "string", "pattern": "^mfr_[A-Za-z0-9_\\-]+$"},
    "risk_class": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "planned_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "planned_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback_plan": {"type": "string", "minLength": 1},
    "sandbox_required": {"type": "boolean", "const": true},
    "branch_creation_allowed": {"type": "boolean", "const": false},
    "commit_allowed": {"type": "boolean", "const": false},
    "pull_request_allowed": {"type": "boolean", "const": false},
    "auto_merge_allowed": {"type": "boolean", "const": false},
    "touches_trading_or_execution": {"type": "boolean", "const": false},
    "credentials_allowed": {"type": "boolean", "const": false}
  }
}
