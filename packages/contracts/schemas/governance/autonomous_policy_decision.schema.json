{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/governance/autonomous_policy_decision.schema.json",
  "title": "AutonomousPolicyDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "autonomous_policy_decision_id",
    "created_at",
    "risk_class",
    "confidence",
    "decision",
    "allowed_next_action",
    "human_approval_required",
    "auto_patch_allowed",
    "auto_pr_allowed",
    "auto_merge_allowed",
    "protected_path_touched",
    "critical_action_detected",
    "rollback_required",
    "audit_required"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "autonomous_policy_decision_id": {"type": "string", "pattern": "^apd_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "risk_class": {"type": "string", "enum": ["low", "medium", "high", "critical", "unknown"]},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "decision": {"type": "string", "enum": ["ALLOW_AUTO_MERGE", "ALLOW_AUTO_PR", "SANDBOX_ONLY", "REQUIRE_EXCEPTION", "BLOCK"]},
    "allowed_next_action": {"type": "string", "enum": ["merge_after_gates", "open_pull_request", "simulate_patch", "exception_review", "none"]},
    "human_approval_required": {"type": "boolean"},
    "auto_patch_allowed": {"type": "boolean"},
    "auto_pr_allowed": {"type": "boolean"},
    "auto_merge_allowed": {"type": "boolean"},
    "protected_path_touched": {"type": "boolean"},
    "critical_action_detected": {"type": "boolean"},
    "rollback_required": {"type": "boolean", "const": true},
    "audit_required": {"type": "boolean", "const": true}
  }
}
