{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-quant-trading-os.local/schemas/governance/repository_monitor_policy.schema.json",
  "title": "RepositoryMonitorPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "repository_monitor_policy_id",
    "created_at",
    "scope",
    "allowed_triggers",
    "allowed_scanners",
    "forbidden_targets",
    "repository_write_allowed",
    "auto_pr_allowed",
    "auto_merge_allowed",
    "github_app_enabled",
    "webhook_receiver_enabled",
    "network_access_allowed",
    "credentials_allowed",
    "production_enabled"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "repository_monitor_policy_id": {"type": "string", "pattern": "^rmp_[A-Za-z0-9_\\-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "enum": ["single_repository", "multi_repository_reference_only"]},
    "allowed_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["manual", "ci_result", "scheduled_dry_run", "webhook_dry_run"]}},
    "allowed_scanners": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["scaffold_audit", "secret_artifact_audit", "contract_tests", "codeql_reference", "semgrep_reference", "trivy_reference"]}},
    "forbidden_targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "repository_write_allowed": {"type": "boolean", "const": false},
    "auto_pr_allowed": {"type": "boolean", "const": false},
    "auto_merge_allowed": {"type": "boolean", "const": false},
    "github_app_enabled": {"type": "boolean", "const": false},
    "webhook_receiver_enabled": {"type": "boolean", "const": false},
    "network_access_allowed": {"type": "boolean", "const": false},
    "credentials_allowed": {"type": "boolean", "const": false},
    "production_enabled": {"type": "boolean", "const": false}
  }
}
